{
  "name": "boom-test-arena",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-physics.mjs && node verification/shots.mjs",
    "verify:browser": "node verification/browser.cjs",
    "verify:world": "node verification/world-browser.cjs",
    "verify:legacy": "node verification/verify.mjs",
    "package:site": "node scripts/package-site.mjs",
    "server": "node server/local.mjs",
    "verify:multiplayer": "node --test verification/battle-server.test.mjs",
    "deploy:server": "npx --yes wrangler@4 deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.17.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "crashcat": "0.0.3",
    "esbuild": "0.27.4",
    "playwright": "1.62.1",
    "ws": "8.18.3"
  }
}
